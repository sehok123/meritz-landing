  <!-- ----------------------------- -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const buttons = document.querySelectorAll(".category-filter button");
      if (!buttons || !buttons.length) return;

      let currentCatId =
        new URL(window.location.href).searchParams.get("cat_id") || 0;

      buttons.forEach((btn) => {
        btn.addEventListener("click", function () {
          buttons.forEach((b) => b.classList.remove("active"));
            this.classList.add("active");

            const catId = this.dataset.cat;
            currentCatId = catId;

            const url = new URL(window.location.href);

            let cleanPath = url.pathname.replace(/\/page\/\d+\//, "/");
            url.pathname = cleanPath;

            // cat_id 설정
            url.searchParams.set("cat_id", catId);
            url.searchParams.delete("paged");

            window.location.href = url.toString();
        });
      });

      // 페이지네이션 클릭 시에도 cat_id 유지
      document.addEventListener("click", function (e) {
        const link = e.target.closest(".nav-links a");
        if (!link) return;

        e.preventDefault();
        const url = new URL(link.href);
        const catFromUrl = new URL(window.location.href).searchParams.get(
          "cat_id"
        );
        if (catFromUrl) url.searchParams.set("cat_id", catFromUrl);
        window.location.href = url.toString();
      });
    });
  </script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const primary = document.querySelector(".voluto-main-container");
      if (!primary) return;
      // 초기 숨김
      primary.style.opacity = "0";
      primary.style.visibility = "hidden";
      // 핵심 이미지 (썸네일)
      const images = primary.querySelectorAll(".post-thumbnail img");
      let loadedCount = 0;
      function showContainer() {
        primary.style.transition = "opacity 0.4s ease-in-out";
        primary.style.visibility = "visible";
        primary.style.opacity = "1";
      }
      if (images.length === 0) {
        showContainer();
        // 이미지 없으면 바로 표시
        return;
      }
      // 이미지 로드 이벤트
      images.forEach((img) => {
        if (img.complete) loadedCount++;
        else {
          img.addEventListener("load", () => {
            loadedCount++;
            checkAll();
          });
          img.addEventListener("error", () => {
            loadedCount++;
            checkAll();
          });
        }
      });
      function checkAll() {
        if (loadedCount === images.length) showContainer();
      }
      // 0.5초 후 강제 표시
      setTimeout(showContainer, 500);
    });
  </script>